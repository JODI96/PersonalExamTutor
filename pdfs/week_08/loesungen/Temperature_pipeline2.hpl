    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding/>
    <fields>
      <field>
        <name>Chemical</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>17</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>Density (g/cm3)</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>Melt (K)</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>Boil (K)</name>
        <type>Number</type>
        <format>#.#</format>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Formula</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>Melt_C</field_name>
        <formula>IF (ISNA ([Melt_K]), -1 , [Melt_K] - 273.15)</formula>
        <set_na>Y</set_na>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>1</value_type>
      </formula>
      <formula>
        <field_name>Boil_C</field_name>
        <formula>IF (ISNA ([Boil_K]), -1 , [Boil_K] - 273.15)</formula>
        <set_na>Y</set_na>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>1</value_type>
      </formula>
      <formula>
        <field_name>Melt_F</field_name>
        <formula>IF (ISNA ([Melt_K]), -1 , ([Melt_K] - 273.15) * 9/5 + 32)</formula>
        <set_na>Y</set_na>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>1</value_type>
      </formula>
      <formula>
        <field_name>Boil_F</field_name>
        <formula>IF (ISNA ([Boil_K]), -1 , ([Boil_K] - 273.15) * 9/5 + 32)</formula>
        <set_na>Y</set_na>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>1</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>624</xloc>
      <yloc>240</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Null if</name>
    <type>NullIf</type>
